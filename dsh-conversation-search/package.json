{
  "name": "@ksd11oj/dsh-conversation-search",
  "version": "0.1.2",
  "description": "Adds Cmd/Ctrl+F-style full-text search over the current conversation in the DeepSeek Harness Web UI.",
  "type": "module",
  "license": "MIT",
  "author": "ksd11oj",
  "homepage": "https://github.com/ksd11/dsh-plugins/tree/master/dsh-conversation-search#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksd11/dsh-plugins.git",
    "directory": "dsh-conversation-search"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "search",
    "conversation",
    "find"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check:manifest": "node scripts/check-manifest.mjs",
    "prepublishOnly": "node scripts/check-manifest.mjs"
  }
}
